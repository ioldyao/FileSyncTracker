<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileSyncTracker.UI.ViewModels"
        xmlns:views="using:FileSyncTracker.UI.Views"
        xmlns:pages="using:FileSyncTracker.UI.Views.Pages"
        x:Class="FileSyncTracker.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppTitle}"
        Width="960" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface0Brush}" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Panel Grid.Column="2"/>
                <Button Grid.Column="3" Content="-" Width="32" Height="28" Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMinimizeClick"/>
                <Button Grid.Column="4" Content="X" Width="32" Height="28" Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}" Click="OnCloseClick"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">

            <!-- Left Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" Padding="8">
                <StackPanel Spacing="4">
                    <Button Classes="nav-btn" Content="{DynamicResource NavDashboard}" Tag="Dashboard" Click="OnNavClick"/>
                    <Button Classes="nav-btn" Content="{DynamicResource NavTasks}" Tag="Tasks" Click="OnNavClick"/>
                    <Button Classes="nav-btn" Content="{DynamicResource NavFiles}" Tag="Files" Click="OnNavClick"/>
                    <Button Classes="nav-btn" Content="{DynamicResource NavSettings}" Tag="Settings" Click="OnNavClick"/>
                    <Button Classes="nav-btn" Content="{DynamicResource NavLogs}" Tag="Logs" Click="OnNavClick"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Panel Grid.Column="1" x:Name="ContentPanel" Background="{DynamicResource AppBackgroundBrush}"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface0Brush}" Padding="12,6">
            <Grid ColumnDefinitions="*,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{DynamicResource StatusEverything}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding EverythingStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{DynamicResource StatusSyncthing}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding SyncthingStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{DynamicResource Version}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
</Window>
