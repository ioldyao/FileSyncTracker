<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileSyncTracker.UI.ViewModels"
        xmlns:views="using:FileSyncTracker.UI.Views"
        xmlns:pages="using:FileSyncTracker.UI.Views.Pages"
        x:Class="FileSyncTracker.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppTitle}"
        Width="1024" Height="680"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface0Brush}" Padding="16,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="FileSyncTracker" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Content="-" Classes="icon" Click="OnMinimizeClick"/>
                    <Button Content="X" Classes="icon" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Sidebar + Content -->
        <Grid Grid.Row="1" ColumnDefinitions="48,*">

            <!-- Icon Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Surface0Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Top Navigation Icons -->
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <!-- Dashboard -->
                        <Button Classes="sidebar-btn" Tag="Dashboard" Click="OnNavClick"
                                ToolTip.Tip="Dashboard" HorizontalAlignment="Center">
                            <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z"
                                  Width="18" Height="18"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Tasks -->
                        <Button Classes="sidebar-btn" Tag="Tasks" Click="OnNavClick"
                                ToolTip.Tip="Tasks" HorizontalAlignment="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z"
                                  Width="18" Height="18"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Files -->
                        <Button Classes="sidebar-btn" Tag="Files" Click="OnNavClick"
                                ToolTip.Tip="Files" HorizontalAlignment="Center">
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Width="18" Height="18"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Logs -->
                        <Button Classes="sidebar-btn" Tag="Logs" Click="OnNavClick"
                                ToolTip.Tip="Logs" HorizontalAlignment="Center">
                            <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7v5h5v11H6zm2-6h8v2H8v-2zm0-3h8v2H8v-2z"
                                  Width="18" Height="18"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>

                    <!-- Bottom: Settings -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Button Classes="sidebar-btn" Tag="Settings" Click="OnNavClick"
                                ToolTip.Tip="Settings" HorizontalAlignment="Center">
                            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                  Width="18" Height="18"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Panel Grid.Column="1" x:Name="ContentPanel" Background="{DynamicResource AppBackgroundBrush}"/>
        </Grid>
    </Grid>
</Window>
