<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FileSyncTracker.UI.Views.Dialogs.AddFolderTaskDialog"
        Title="{DynamicResource AddFolderTask}"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="{DynamicResource AddFolderTask}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBox Name="TaskNameBox" Watermark="{DynamicResource TaskName}" Classes="input"/>
                <TextBox Name="LocalPathBox" Watermark="{DynamicResource LocalFolderPath}" Classes="input"/>
                <TextBox Name="RemoteTargetBox" Watermark="{DynamicResource RemoteTarget}" Classes="input"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Classes="secondary" Click="OnCancel"/>
                <Button Content="{DynamicResource Create}" Classes="accent" Click="OnCreate"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
