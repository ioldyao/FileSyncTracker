<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FileSyncTracker.UI.Views.Dialogs.AddFolderTaskDialog"
        Title="{DynamicResource AddFolderTask}"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="{DynamicResource AddFolderTask}" FontSize="20" FontWeight="Bold"
                       Foreground="#CDD6F4" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBox Name="TaskNameBox" Watermark="{DynamicResource TaskName}" Background="#45475A" Foreground="#CDD6F4"/>
                <TextBox Name="LocalPathBox" Watermark="{DynamicResource LocalFolderPath}" Background="#45475A" Foreground="#CDD6F4"/>
                <TextBox Name="RemoteTargetBox" Watermark="{DynamicResource RemoteTarget}" Background="#45475A" Foreground="#CDD6F4"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Background="#45475A" Foreground="#CDD6F4" CornerRadius="6" Padding="12,6"
                        Click="OnCancel"/>
                <Button Content="{DynamicResource Create}" Background="#5B6CF8" Foreground="White" CornerRadius="6" Padding="12,6"
                        Click="OnCreate"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
