<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.SettingsPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center">

            <!-- Everything -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Everything" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Everything64.dll 路径"/>
                        <TextBox Text="{Binding EverythingPath}"
                                 Watermark="C:\Program Files\Everything\Everything64.dll"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="状态：" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EverythingStatusText}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Syncthing -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Syncthing" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="syncthing.exe 路径"/>
                        <TextBox Text="{Binding SyncthingPath}"
                                 Watermark="C:\Program Files\Syncthing\syncthing.exe"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="API 地址"/>
                        <TextBox Text="{Binding SyncthingApiUrl}"
                                 Watermark="http://127.0.0.1:8384"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="状态：" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SyncthingStatusText}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- General -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="常规" FontSize="18" FontWeight="SemiBold"/>
                    <CheckBox Content="最小化到系统托盘"
                              IsChecked="{Binding MinimizeToTray}"/>
                    <CheckBox Content="开机自启动"
                              IsChecked="{Binding AutoStart}"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="日志保留天数"/>
                        <NumericUpDown Value="{Binding LogRetentionDays}"
                                       Minimum="1" Maximum="365"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- WebDAV -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="WebDAV 服务器" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Command="{Binding AddWebDavCommand}"
                                Width="32" Height="32" Padding="0"/>
                    </StackPanel>

                    <!-- WebDAV Edit Form -->
                    <Border BorderBrush="#5B6CF8" BorderThickness="1" CornerRadius="4"
                            Padding="12" IsVisible="{Binding IsEditingWebDav}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="编辑 WebDAV 服务器" FontWeight="SemiBold"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="名称"/>
                                <TextBox Text="{Binding EditingWebDav.Name}" Watermark="例如: 坚果云"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="URL"/>
                                <TextBox Text="{Binding EditingWebDav.Url}" Watermark="https://dav.jianguoyun.com"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="用户名"/>
                                <TextBox Text="{Binding EditingWebDav.Username}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="密码"/>
                                <TextBox Text="{Binding EditingWebDav.Password}" PasswordChar="*"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="取消" Command="{Binding CancelWebDavCommand}" Padding="16,6"/>
                                <Button Content="保存" Command="{Binding SaveWebDavCommand}" Padding="16,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding WebDavServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Url}" Foreground="Gray" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Content="编辑" Command="{Binding $parent[ItemsControl].DataContext.EditWebDavCommand}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                            <Button Content="删除" Command="{Binding $parent[ItemsControl].DataContext.DeleteWebDavCommand}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无配置" Foreground="Gray"
                               IsVisible="{Binding !WebDavServers.Count}"/>
                </StackPanel>
            </Border>

            <!-- OneDrive -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="OneDrive 账户" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Command="{Binding AddOneDriveCommand}"
                                Width="32" Height="32" Padding="0"/>
                    </StackPanel>

                    <!-- OneDrive Edit Form -->
                    <Border BorderBrush="#5B6CF8" BorderThickness="1" CornerRadius="4"
                            Padding="12" IsVisible="{Binding IsEditingOneDrive}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="编辑 OneDrive 账户" FontWeight="SemiBold"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="账户名称"/>
                                <TextBox Text="{Binding EditingOneDrive.Name}" Watermark="例如: 个人OneDrive"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Access Token"/>
                                <TextBox Text="{Binding EditingOneDrive.AccessToken}" PasswordChar="*"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Refresh Token"/>
                                <TextBox Text="{Binding EditingOneDrive.RefreshToken}" PasswordChar="*"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="取消" Command="{Binding CancelOneDriveCommand}" Padding="16,6"/>
                                <Button Content="保存" Command="{Binding SaveOneDriveCommand}" Padding="16,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding OneDriveAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="OneDrive 账户" Foreground="Gray" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Content="编辑" Command="{Binding $parent[ItemsControl].DataContext.EditOneDriveCommand}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                            <Button Content="删除" Command="{Binding $parent[ItemsControl].DataContext.DeleteOneDriveCommand}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无配置" Foreground="Gray"
                               IsVisible="{Binding !OneDriveAccounts.Count}"/>
                </StackPanel>
            </Border>

            <!-- S3 -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="S3 存储" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Command="{Binding AddS3Command}"
                                Width="32" Height="32" Padding="0"/>
                    </StackPanel>

                    <!-- S3 Edit Form -->
                    <Border BorderBrush="#5B6CF8" BorderThickness="1" CornerRadius="4"
                            Padding="12" IsVisible="{Binding IsEditingS3}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="编辑 S3 存储" FontWeight="SemiBold"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="名称"/>
                                <TextBox Text="{Binding EditingS3.Name}" Watermark="例如: 阿里云OSS"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Endpoint"/>
                                <TextBox Text="{Binding EditingS3.Endpoint}" Watermark="https://oss-cn-hangzhou.aliyuncs.com"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Bucket"/>
                                <TextBox Text="{Binding EditingS3.Bucket}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Access Key"/>
                                <TextBox Text="{Binding EditingS3.AccessKey}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Secret Key"/>
                                <TextBox Text="{Binding EditingS3.SecretKey}" PasswordChar="*"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Region"/>
                                <TextBox Text="{Binding EditingS3.Region}" Watermark="cn-hangzhou"/>
                            </StackPanel>
                            <CheckBox Content="使用 Path Style" IsChecked="{Binding EditingS3.UsePathStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="取消" Command="{Binding CancelS3Command}" Padding="16,6"/>
                                <Button Content="保存" Command="{Binding SaveS3Command}" Padding="16,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding S3Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Bucket}" Foreground="Gray" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Content="编辑" Command="{Binding $parent[ItemsControl].DataContext.EditS3Command}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                            <Button Content="删除" Command="{Binding $parent[ItemsControl].DataContext.DeleteS3Command}"
                                                    CommandParameter="{Binding}" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无配置" Foreground="Gray"
                               IsVisible="{Binding !S3Servers.Count}"/>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button Content="保存设置" Click="OnSaveClick"
                    HorizontalAlignment="Right" Padding="24,8"
                    Classes="accent"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
