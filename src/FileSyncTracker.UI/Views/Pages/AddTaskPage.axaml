<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             xmlns:models="using:FileSyncTracker.Core.Models"
             xmlns:local="using:FileSyncTracker.UI.Converters"
             x:Class="FileSyncTracker.UI.Views.Pages.AddTaskPage"
             x:DataType="vm:AddTaskViewModel">

    <Border Padding="28,24">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource AddTaskTitle}" Classes="page-header"/>
                <TextBlock Text="Create a new sync task" Classes="page-subtitle"/>
            </StackPanel>

            <!-- Step Content -->
            <Border Grid.Row="1" Classes="table-container">
                <ScrollViewer>
                    <Border Padding="24">
                    <StackPanel Spacing="24">
                        <!-- Step Indicator -->
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- Step 1 -->
                            <Ellipse Grid.Column="0" Width="28" Height="28" HorizontalAlignment="Center"
                                     Fill="{Binding CurrentStep, Converter={x:Static local:StepToFillConverter.Instance}, ConverterParameter=1}"/>
                            <Border Grid.Column="1" Height="2" Width="40" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            <!-- Step 2 -->
                            <Ellipse Grid.Column="2" Width="28" Height="28" HorizontalAlignment="Center"
                                     Fill="{Binding CurrentStep, Converter={x:Static local:StepToFillConverter.Instance}, ConverterParameter=2}"/>
                            <Border Grid.Column="3" Height="2" Width="40" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            <!-- Step 3 -->
                            <Ellipse Grid.Column="4" Width="28" Height="28" HorizontalAlignment="Center"
                                     Fill="{Binding CurrentStep, Converter={x:Static local:StepToFillConverter.Instance}, ConverterParameter=3}"/>
                            <Border Grid.Column="5" Height="2" Width="40" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            <!-- Step 4 -->
                            <Ellipse Grid.Column="6" Width="28" Height="28" HorizontalAlignment="Center"
                                     Fill="{Binding CurrentStep, Converter={x:Static local:StepToFillConverter.Instance}, ConverterParameter=4}"/>
                        </Grid>

                        <!-- Step 1: Type Selection -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentStep, Converter={x:Static local:IntToBoolConverter.Instance}, ConverterParameter=1}">
                            <TextBlock Text="{DynamicResource SelectTaskType}" Classes="section-title"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                                <Border Grid.Column="0" CornerRadius="10" Padding="20" Margin="0,0,8,0"
                                        Cursor="Hand" PointerPressed="OnFolderSelected"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Background="{Binding SelectedType, Converter={x:Static local:TypeToSelectionConverter.Instance}, ConverterParameter=Folder}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource FolderType}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Padding="20" Margin="8,0,0,0"
                                        Cursor="Hand" PointerPressed="OnFileSelected"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Background="{Binding SelectedType, Converter={x:Static local:TypeToSelectionConverter.Instance}, ConverterParameter=File}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource SingleFileType}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Step 2: Path Selection -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentStep, Converter={x:Static local:IntToBoolConverter.Instance}, ConverterParameter=2}">
                            <TextBlock Text="{DynamicResource SelectPath}" Classes="section-title"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource TaskName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding TaskName}" Watermark="{DynamicResource TaskName}" Classes="input"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource LocalPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding LocalPath}" Watermark="{DynamicResource LocalPath}" Classes="input" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="{DynamicResource Browse}" Classes="accent"
                                            Click="OnBrowseClick"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 3: Storage Selection -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentStep, Converter={x:Static local:IntToBoolConverter.Instance}, ConverterParameter=3}">
                            <TextBlock Text="{DynamicResource StorageConfig}" Classes="section-title"/>
                            <TextBlock Text="{DynamicResource SelectBackupTargets}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <!-- Remote Path -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Remote Path" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding RemotePath}" Watermark="Remote Path (e.g., /backup)" Classes="input"/>
                            </StackPanel>

                            <!-- Download Path -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Download Path" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding DownloadPath}" Watermark="Download Path (e.g., C:\MyFiles, optional)" Classes="input"/>
                            </StackPanel>

                            <!-- No servers configured hint -->
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding !HasAnyCloud}">
                                <TextBlock Text="{DynamicResource NoCloudConfigured}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- WebDAV Servers -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasWebDav}">
                                <TextBlock Text="☁️ WebDAV" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                <ItemsControl ItemsSource="{Binding AvailableWebDav}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="table-row" Cursor="Hand" Tag="{Binding}"
                                                    PointerPressed="OnServerCardPressed">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                                             Fill="{DynamicResource TextSecondaryBrush}"/>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Url}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- OneDrive Accounts -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasOneDrive}">
                                <TextBlock Text="📁 OneDrive" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                <ItemsControl ItemsSource="{Binding AvailableOneDrive}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="table-row" Cursor="Hand" Tag="{Binding}"
                                                    PointerPressed="OnServerCardPressed">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                                             Fill="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- S3 Servers -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasS3}">
                                <TextBlock Text="🗄️ S3" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                <ItemsControl ItemsSource="{Binding AvailableS3}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="table-row" Cursor="Hand" Tag="{Binding}"
                                                    PointerPressed="OnServerCardPressed">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                                             Fill="{DynamicResource TextSecondaryBrush}"/>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Bucket}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Selected targets summary -->
                            <Border CornerRadius="8" Padding="12"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource SelectedTargets}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedTargets.Count}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Step 4: Schedule -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentStep, Converter={x:Static local:IntToBoolConverter.Instance}, ConverterParameter=4}">
                            <TextBlock Text="{DynamicResource SyncMode}" Classes="section-title"/>
                            <RadioButton Content="{DynamicResource RealTime}" GroupName="SyncMode"
                                         FontSize="13" IsChecked="{Binding IsRealTimeMode}"/>
                            <RadioButton Content="{DynamicResource Scheduled}" GroupName="SyncMode"
                                         FontSize="13" IsChecked="{Binding IsScheduledMode}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Cron Expression" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding CronExpression}" Watermark="{DynamicResource CronExpression}" Classes="input"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>

            <!-- Navigation Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <Button Grid.Column="0" Content="{DynamicResource Back}" Classes="secondary"
                        IsVisible="{Binding CurrentStep, Converter={x:Static local:GreaterThanOneConverter.Instance}}"
                        Click="OnPrevStepClick"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{DynamicResource Next}" Classes="accent"
                            IsVisible="{Binding CurrentStep, Converter={x:Static local:LessThanFourConverter.Instance}}"
                            Click="OnNextStepClick"/>
                    <Button Content="{DynamicResource Create}" Classes="success"
                            FontWeight="SemiBold"
                            IsVisible="{Binding CurrentStep, Converter={x:Static local:EqualToFourConverter.Instance}}"
                            Click="OnCreateClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
