<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.FilesPage">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0" Text="远端文件" Classes="page-header"/>
                <Button Grid.Column="1" Content="刷新" Classes="accent sm"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Server Groups -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding TaskGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <!-- Server Header -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ServerName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding ServerType}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} 个文件">
                                                    <Binding Path="Files.Count"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- File List -->
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" CornerRadius="6"
                                                        Background="{DynamicResource Surface2Brush}" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Column="0" Grid.Row="0"
                                                                   Text="{Binding FileName}" FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Grid.Row="0"
                                                                   Text="{Binding FileSizeDisplay}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Grid.Row="0"
                                                                   Text="{Binding LastModifiedDisplay}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <TextBlock Grid.Column="0" Grid.Row="1"
                                                                   Text="{Binding TaskName, StringFormat='任务: {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
