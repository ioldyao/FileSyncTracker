<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.FilesPage"
             x:DataType="vm:FilesViewModel">

    <Border Padding="28,24">
        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="远端文件" Classes="page-header"/>
                    <TextBlock Text="Files on remote servers" Classes="page-subtitle"/>
                </StackPanel>
                <Button Grid.Column="1" Content="刷新" Classes="secondary"
                        VerticalAlignment="Top" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Server Groups -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="TaskGroupsControl" ItemsSource="{Binding TaskGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <!-- Server Header -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding ServerName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Classes="badge" Background="{DynamicResource AccentSubtleBrush}">
                                            <TextBlock Text="{Binding ServerType}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} 个文件">
                                                <Binding Path="Files.Count"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <!-- File Table -->
                                <Border Classes="table-container">
                                    <StackPanel>
                                        <!-- Table Header -->
                                        <Border Classes="table-header-row">
                                        <Grid ColumnDefinitions="*,100,140,120,70">
                                            <TextBlock Grid.Column="0" Text="文件名" Classes="table-header"/>
                                            <TextBlock Grid.Column="1" Text="大小" Classes="table-header"/>
                                            <TextBlock Grid.Column="2" Text="修改时间" Classes="table-header"/>
                                            <TextBlock Grid.Column="3" Text="路径" Classes="table-header"/>
                                            <TextBlock Grid.Column="4" Text="" Classes="table-header"/>
                                        </Grid>
                                        </Border>

                                        <!-- Table Rows -->
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="table-row">
                                                        <Grid ColumnDefinitions="*,100,140,120,60">
                                                            <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileSizeDisplay}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastModifiedDisplay}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding RemotePath}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="4" Content="下载" Classes="secondary sm"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                    Command="{Binding ElementName=TaskGroupsControl, Path=DataContext.DownloadFileCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
