<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             xmlns:models="using:FileSyncTracker.Core.Models"
             xmlns:local="using:FileSyncTracker.UI.Converters"
             x:Class="FileSyncTracker.UI.Views.Pages.TaskListPage"
             x:DataType="vm:TaskListViewModel">

    <Border Padding="28,24">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource TaskListTitle}" Classes="page-header"/>
                    <TextBlock Text="Manage your sync tasks" Classes="page-subtitle"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource AddTask}" Classes="accent"
                        VerticalAlignment="Top" Click="OnAddTaskClick"/>
            </Grid>

            <!-- Table -->
            <Border Grid.Row="1" Classes="table-container">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Classes="table-header-row">
                    <Grid ColumnDefinitions="40,140,*,90,120,Auto">
                        <TextBlock Grid.Column="0" Text="" Classes="table-header"/>
                        <TextBlock Grid.Column="1" Text="名称" Classes="table-header"/>
                        <TextBlock Grid.Column="2" Text="路径" Classes="table-header"/>
                        <TextBlock Grid.Column="3" Text="状态" Classes="table-header"/>
                        <TextBlock Grid.Column="4" Text="上次同步" Classes="table-header"/>
                        <TextBlock Grid.Column="5" Text="操作" Classes="table-header" Margin="0,0,4,0"/>
                    </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="40,140,*,90,120,Auto">
                                            <!-- Type Icon -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Type, Converter={x:Static local:TypeToIconConverter.Instance}}"
                                                       FontSize="16" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <!-- Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Path -->
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentPath}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Status -->
                                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={x:Static local:StatusToColorConverter.Instance}}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White"/>
                                            </Border>

                                            <!-- Last Sync -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding LastSyncTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="{DynamicResource SyncNow}" Classes="accent sm"
                                                        Command="{Binding $parent[ItemsControl].DataContext.SyncNowCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Edit" Classes="secondary sm"
                                                        Command="{Binding $parent[ItemsControl].DataContext.EditTaskCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{DynamicResource Delete}" Classes="danger sm"
                                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteTaskCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
