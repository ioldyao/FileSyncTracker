<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="0">
            <!-- Header -->
            <TextBlock Text="{DynamicResource DashboardTitle}" Classes="page-header"/>
            <TextBlock Text="Overview of your sync tasks" Classes="page-subtitle"/>

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,28">
                <Border Grid.Column="0" Classes="stat-card" Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TotalTasks}" Classes="table-header"/>
                        <TextBlock Text="{Binding TotalTasks}" Classes="stat-value"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="stat-card" Margin="6,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Syncing}" Classes="table-header"/>
                        <TextBlock Text="{Binding SyncingTasks}" Classes="stat-value"
                                   Foreground="{DynamicResource InfoBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="stat-card" Margin="12,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Tracking}" Classes="table-header"/>
                        <TextBlock Text="{Binding TrackingTasks}" Classes="stat-value"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="divider"/>

            <!-- Recent Activity -->
            <TextBlock Text="{DynamicResource RecentActivity}" Classes="section-title"/>
            <Border Classes="table-container">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Classes="table-header-row">
                    <Grid ColumnDefinitions="180,*,100,120">
                        <TextBlock Grid.Column="0" Text="任务名称" Classes="table-header"/>
                        <TextBlock Grid.Column="1" Text="路径" Classes="table-header"/>
                        <TextBlock Grid.Column="2" Text="状态" Classes="table-header"/>
                        <TextBlock Grid.Column="3" Text="上次同步" Classes="table-header"/>
                    </Grid>
                    </Border>
                    <!-- Table Rows -->
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="180,*,100,120">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding LastSyncTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
