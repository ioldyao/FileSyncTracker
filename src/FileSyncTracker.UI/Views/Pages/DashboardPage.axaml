<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <!-- Header -->
            <TextBlock Text="{DynamicResource DashboardTitle}" Classes="page-header"/>

            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <!-- Total Tasks -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TotalTasks}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding TotalTasks}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Syncing -->
                <Border Grid.Column="1" Classes="card" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Syncing}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding SyncingTasks}" Foreground="{DynamicResource InfoBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Tracking -->
                <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Tracking}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding TrackingTasks}" Foreground="{DynamicResource WarningBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource RecentActivity}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding CurrentPath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LastSyncTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
