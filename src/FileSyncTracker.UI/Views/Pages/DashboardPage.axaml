<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <!-- Header -->
            <TextBlock Text="{DynamicResource DashboardTitle}" FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"/>

            <!-- Stats Cards -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <!-- Total Tasks -->
                <Border Grid.Column="0" Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource TotalTasks}" Foreground="#6C7086" FontSize="13"/>
                        <TextBlock Text="{Binding TotalTasks}" Foreground="#CDD6F4" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Syncing -->
                <Border Grid.Column="1" Background="#313244" CornerRadius="8" Padding="16" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Syncing}" Foreground="#6C7086" FontSize="13"/>
                        <TextBlock Text="{Binding SyncingTasks}" Foreground="#89B4FA" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Tracking -->
                <Border Grid.Column="2" Background="#313244" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Tracking}" Foreground="#6C7086" FontSize="13"/>
                        <TextBlock Text="{Binding TrackingTasks}" Foreground="#FAB387" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Background="#313244" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource RecentActivity}" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#45475A" CornerRadius="6" Padding="12,8" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" Foreground="#CDD6F4" FontSize="13"/>
                                            <TextBlock Text="{Binding CurrentPath}" Foreground="#6C7086" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LastSyncTime, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                   Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
