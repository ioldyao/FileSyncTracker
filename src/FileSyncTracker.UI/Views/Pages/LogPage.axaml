<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.LogPage"
             x:DataType="vm:LogViewModel">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{DynamicResource LogsTitle}" Classes="page-header" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Classes="card">
                <ListBox ItemsSource="{Binding LogEntries}"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         FontFamily="Cascadia Code,Consolas" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
