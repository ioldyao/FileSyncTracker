<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileSyncTracker.UI.ViewModels"
             x:Class="FileSyncTracker.UI.Views.Pages.LogPage"
             x:DataType="vm:LogViewModel">

    <Border Padding="28,24">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource LogsTitle}" Classes="page-header"/>
                <TextBlock Text="Application logs" Classes="page-subtitle"/>
            </StackPanel>

            <Border Grid.Row="1" Classes="table-container">
                <ListBox ItemsSource="{Binding LogEntries}"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         FontFamily="Cascadia Code,Consolas" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
