<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    x:Class="FileSyncTracker.UI.Themes.Colors">

    <!-- Background layers -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Surface0Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#E8EAED"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#D1D5DB"/>

    <!-- Hover / Focus -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#5E6AD2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0D0D12"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9CA3AF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5E6AD2"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F5AB8"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#5E6AD20D"/>

    <!-- Navigation -->
    <SolidColorBrush x:Key="NavActiveIndicatorBrush" Color="#5E6AD2"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
</ResourceDictionary>
